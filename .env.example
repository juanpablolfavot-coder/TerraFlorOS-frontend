# TerraFlorOS frontend — variables de entorno
# Copiar a .env.local y ajustar. NUNCA subir el .env real a GitHub.

# Origen del backend (SIN el sufijo /api: las rutas del cliente ya lo incluyen).
# Desarrollo local:
VITE_API_URL=http://localhost:3000
# Producción (ejemplo Render):
# VITE_API_URL=https://terrafloros-backend.onrender.com

# Nombre visible del negocio en la interfaz (opcional).
VITE_APP_NAME=TerraFlorOS
